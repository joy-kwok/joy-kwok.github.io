 {
   "slug": "motion-poster",
   "title": "Motion Poster",
   "date": 2025,
   "description": "This project was a final for my motion graphics class, where we were assigned a poster to create into a visual music animation exploring principles of motion within shapes and composition, typography, and syncopation. I chose a poster with interesting rotating elements, syncing it with an energetic, plucky song to utilize snappy cuts and typography that aligned with the movements of the composition.",
   "category": "2d-motion-graphics",
   "sub-folder": "Motion Poster",
   "main-item-dir": "2dmg_Motion_Poster_Main",
